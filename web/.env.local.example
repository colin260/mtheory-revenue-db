# Copy to .env.local (local) or set these in your host's environment (production).
AUTH_SECRET=                    # openssl rand -base64 32
ALLOWED_EMAIL_DOMAIN=           # your Google Workspace domain, e.g. mtheory.com (no @)
AUTH_GOOGLE_ID=                 # Google Cloud OAuth client ID
AUTH_GOOGLE_SECRET=             # Google Cloud OAuth client secret
DATABASE_URL=                   # Supabase connection string (leave blank locally)
BOOTSTRAP_FINANCE_EMAIL=        # local embedded DB only: first finance user. On Supabase insert one row into app_users instead.
ANTHROPIC_API_KEY=              # turns on Add data > From a PDF (statements are sent to Anthropic's API)
ANTHROPIC_MODEL=                # optional, default claude-opus-5-5
PDF_REC_EFFORT=                 # optional: low | medium (default) | high
PDF_REC_DEMO=                   # local only: 1 = made-up sample data when there is no API key
